// Add this block inside `match /databases/{database}/documents { ... }`
// in Firebase Console → Firestore → Rules, then Publish.
// It lets visitors publish an anonymous, tightly-shaped presence doc.
match /presence/{sessionId} {
  allow read: if true;
  allow create, update: if sessionId.size() <= 16
    && request.resource.data.keys().hasOnly(['x', 'z', 'h', 'moving', 'country', 'at'])
    && request.resource.data.x is number && request.resource.data.x > -100 && request.resource.data.x < 100
    && request.resource.data.z is number && request.resource.data.z > -100 && request.resource.data.z < 100
    && request.resource.data.h is number
    && request.resource.data.moving is bool
    && request.resource.data.country is string && request.resource.data.country.size() <= 2
    && request.resource.data.at is int;
  allow delete: if true;
}
