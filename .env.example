# Copy to .env.local for local development (never commit real keys).
# On Vercel: Project → Settings → Environment Variables, then redeploy.

# --- AI Eldad (text chat) ---
# If set, chat goes through OpenRouter; otherwise it falls back to OPENAI_API_KEY.
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- OpenAI ---
# Required for 🎙️ voice chat (OpenAI Realtime). Also used for text chat when
# OPENROUTER_API_KEY is not set.
OPENAI_API_KEY=

# --- GitHub City (optional) ---
# Raises GitHub's API rate limit for repo/stack detection.
GITHUB_TOKEN=

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Contact form (optional) ---
RESEND_API_KEY=
CONTACT_EMAIL_TO=eldadykn@gmail.com
